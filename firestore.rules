rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Questions: Public read for enabled questions; Admin-only write
    match /questions/{questionId} {
      allow read: if resource.data.enabled == true || request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Leaderboard entries:
    // Anyone can read entries; create requires valid structure & bounds
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.mainScore >= 0
                    && request.resource.data.mainScore <= 5
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() <= 20
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.totalPoints >= 0;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Analytics and settings: Admin only
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
